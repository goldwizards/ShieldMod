Items: {
	FragmentOfProtection: {
		DisplayName: Fragment of Protection
		Tooltip:
			'''
			While your shield is active:
			• Defense increased by 5%

			"A faintly flickering shard from a broken shield.
			A small light, yet it carries an unyielding will."
			'''
	}

	GemOfProtection: {
		DisplayName: Gem of Protection
		Tooltip:
			'''
			While your shield is active:
			• Defense increased by 10%

			"A finely crafted gem radiating a gentle aura of protection.
			It wraps the wearer’s heart in a comforting warmth."
			'''
	}

	EssenceOfProtection: {
		DisplayName: Essence of Protection
		Tooltip:
			'''
			While your shield is active:
			• Defense increased by 15%
			• Damage taken reduced by 5%
			• Shield regeneration rate increased by 30%

			"The crystallized essence of pure guardianship.
			Lets you stand firm against waves of oncoming threats."
			'''
	}

	CoreOfProtection: {
		DisplayName: Core of Protection
		Tooltip:
			'''
			While your shield is active:
			• Defense increased by 20%
			• Damage taken reduced by 10%
			• Shield regeneration rate increased by 60%

			"The ultimate core where all defensive power converges.
			Its very presence becomes a wall stronger than steel."
			'''
	}

	AbsorptionSigil: {
		DisplayName: Absorption Sigil
		Tooltip:
			'''
			Deal damage to restore your shield equal to 4% of damage dealt.
			(Direct hits only; DoT/debuff damage is excluded.)
			Disables all shield regeneration while equipped.

			"A crimson mark that drinks from your strikes and returns it as a barrier."
			'''
	}

	EmergencyAegis: {
		DisplayName: Emergency Aegis
		Tooltip:
			'''
			At ≤35% life, restore your shield to full over 3s. (300s cooldown; resets on death)
			+2 shield regen per second
			Killing any enemy restores 20 shield (2s ICD; bosses ignore ICD)
			Shield-break regen delay -2s (5s -> 3s)
			A last-resort lunar bulwark that answers only at the brink.
			'''
	}
}

Configs: {
	ShieldModConfig: {
		DisplayName: Shield Mod Config

		Headers: {
			UI: UI
			Multiplayer: Multiplayer
			VFXNumbers: VFX - Numbers
			VFXHitEffects: VFX - Hit Effects
			BubbleShield: Bubble Shield
		}

		ShowShieldText: {
			Label: Show shield absorption numbers
			Tooltip: Displays numbers for damage absorbed by your shield.
		}

		ShieldUIStyle: {
			Label: Shield UI style
			Tooltip: Choose between the bar UI and the icon UI.
		}

		UseShieldPulseEffect: {
			Label: Pulse animation effect
			Tooltip: When using the icon UI, pulses only the last remaining shield icon.
		}

		ShieldMaxRatio: {
			Label: Shield Max Health Ratio
			Tooltip:
				'''
				Set the maximum shield as a percentage of the player's max health (statLifeMax2).
				Example: 1.00 = 100%, 0.25 = 25%
				'''
		}

		EnableShieldElectricEffect: {
			Label: Energy shimmer effect (bar)
			Tooltip: Adds an animated energy shimmer inside the filled portion of the bar UI.
		}

		ShieldHitColor: {
			Label: Shield hit effect color
			Tooltip: Color used for the shield-hit overlay and shield absorption numbers.
		}

		ShieldRegenColor: {
			Label: Shield regen effect color
			Tooltip: Color used for shield regeneration (healing) numbers.
		}

		BubbleShieldDoubleDraw: {
			Tooltip: Draws the bubble twice for a slightly stronger glow.
			Label: Extra glow pass
		}

		BubbleShieldBob: {
			Tooltip: Adds a small vertical bobbing motion to the bubble.
			Label: Bubble bobbing
		}

		BubbleShieldPulseOnLow: {
			Tooltip: Adds a subtle pulse to the bubble when shield is at or below 25%.
			Label: Pulse when shield is low
		}

		BubbleShieldOpacity: {
			Tooltip: Opacity of the bubble overlay (0.0 = invisible, 1.0 = solid).
			Label: Bubble shield opacity
		}

		EnableBubbleShield: {
			Tooltip: Draws a simple bubble overlay around your character when shield > 0.
			Label: Enable bubble shield (player)
		}

		HitEffectStyle: {
			Tooltip: Select how the shield hit visual effect is displayed.
			Label: Hit effect style
		}

		ShowOtherPlayersShieldWhenFull: {
			Tooltip: When enabled, the overhead 2px shield line is shown whenever other players have shield > 0 (even at full).
			Label: Show other players' shield when full
		}

		ShowRegenCooldownIndicator: {
			Tooltip: Displays your current shield regeneration tier (1/2/3/5/8/12/20 per second) or break cooldown as a small HUD label.
			Label: Show regen/cooldown hint
		}
	}

	ShieldUIDisplayStyle: {
		Tooltip: ""

		Bar: {
			Label: Bar UI
			Tooltip: ""
		}

		Icon: {
			Label: Icon UI
			Tooltip: ""
		}
	}

	ShieldModServerConfig: {
		DisplayName: Shield Mod Server Config

		ShieldMaxRatio: {
			Label: Shield Max Health Ratio (Server)
			Tooltip:
				'''
				Multiplayer only: Server-authoritative maximum shield ratio.
				Set maximum shield as a percentage of the player's max health (statLifeMax2).
				Example: 1.00 = 100%, 0.25 = 25%
				'''
		}
	}

	ShieldHitVfxStyle: {
		ImpactOnly: {
			Tooltip: ""
			Label: Impact-only
		}

		Strong: {
			Tooltip: ""
			Label: Strong
		}

		Normal: {
			Tooltip: ""
			Label: Normal
		}

		Subtle: {
			Tooltip: ""
			Label: Subtle
		}

		Off: {
			Tooltip: ""
			Label: Off
		}

		Tooltip: ""
	}
}

UI: {
	Cooldown: Cooldown {0}
	Regen: Regen {0}/s
	RegenWithAegis: Regen {0}/s (+{1})
	RegenPaused: Regen paused
	AbsorbReduced: Absorb reduced {0}
	AbsorbNormal: Absorb normal
}

Buffs: {
	EmergencyAegisCooldown: {
		DisplayName: Emergency Aegis Cooldown
		Description: On cooldown
	}
}
